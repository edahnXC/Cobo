{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CollaborativeWorkspaceDb;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS_LONG",
    "Issuer": "CollaborativeWorkspace",
    "Audience": "CollaborativeWorkspaceClient",
    "ExpiryMinutes": "60"
  },
  "Stripe": {
    "SecretKey": "sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY",
    "WebhookSecret": "whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET"
  },
  "SendGrid": {
    "ApiKey": "SG.REPLACE_WITH_YOUR_SENDGRID_API_KEY",
    "FromEmail": "noreply@cobo.app",
    "FromName": "Cobo Platform",
    "SandboxMode": "true"
  },
  "AppSettings": {
    "BaseUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
